#只支持 OpenAI 兼容格式 的大模型 API

LLM_PROVIDER=custom
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-model-name
# 默认 auto 沿用客户端兼容策略；端点支持流式用量时设 true 可采集 token 尾片段。
# 不支持 include_usage 的端点设 false；此时缺失用量会明确记录为 null。
LLM_STREAM_USAGE=auto

# Tavily API Key
TAVILY_API_KEY=your_tavily_api_key_here

#Mineru API Key
MINERU_API_KEY=your_mineru_api_key_here

# 可选成本估算：默认留空，缺少任一单价或 token 时成本为 null。
# 单位为美元/百万 token；两项必须对应本次选择的模型，切换模型时同步更新。
# 调大单价只提高成本估算，不影响决策、调用次数或 token 预算。
AGENT_LLM_INPUT_COST_PER_MILLION=
AGENT_LLM_OUTPUT_COST_PER_MILLION=

