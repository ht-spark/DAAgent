#只支持 OpenAI 兼容格式 的大模型 API

LLM_PROVIDER=custom
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-model-name
# 默认 auto 沿用客户端兼容策略；端点支持流式用量时设 true 可采集 token 尾片段。
# 不支持 include_usage 的端点设 false；此时缺失用量会明确记录为 null。
LLM_STREAM_USAGE=auto

# Tavily API Key
TAVILY_API_KEY=your_tavily_api_key_here

#Mineru API Key
MINERU_API_KEY=your_mineru_api_key_here

# 可选成本估算：默认留空，缺少任一单价或 token 时成本为 null。
# 单位为美元/百万 token；两项必须对应本次选择的模型，切换模型时同步更新。
# 调大单价只提高成本估算，不影响决策、调用次数或 token 预算。
AGENT_LLM_INPUT_COST_PER_MILLION=
AGENT_LLM_OUTPUT_COST_PER_MILLION=

# 默认 auto 优先原生工具调用，明确不支持或调用解析失败时，本轮后续决策切回 JSON。
# json 恢复单工具协议；native 强制原生并保留错误，适合确认供应商支持后的排查。
AGENT_TOOL_MODE=auto
# 默认 4，范围 1～16；设 1 禁用并行。调大增加吞吐、内存和外部请求压力。
# 仅显式许可的独立只读工具可并行；代码、写文件、终端和技能脚本始终串行。
AGENT_MAX_PARALLEL_TOOLS=4

# 动态计划复审默认开启；false 关闭成功路径复审，失败恢复和真实观察可见仍保留。
AGENT_ADAPTIVE_REPLAN_ENABLED=true
# 成功路径最多改变计划 2 次（0～8），独立于失败恢复预算；0 禁用，调大增加模型开销。
AGENT_MAX_ADAPTIVE_REPLANS=2
# 默认 0 只在 Todo 边界复审；1～160 按工具决策批次间隔触发，越小越频繁且成本越高。
AGENT_REPLAN_CHECK_INTERVAL=0
# 最多复审 6 次（0～24），包括继续原计划和复审失败；0 禁用，调大增加额外模型请求。
AGENT_MAX_PLAN_REVIEWS=6

# 默认开启独立语义验证；false 仅关闭模型复核，产物文件检查仍保留并明确披露验证范围。
AGENT_VERIFIER_ENABLED=true
# 失败后默认允许修订 1 次，范围 0～3；0 只核验不修订，调大增加模型与补查工具开销。
# 修订沿用本轮工具决策预算，不重置额度；用尽后保留未通过项并公开标为未完全验证。
AGENT_MAX_VERIFY_RETRIES=1

# 默认开启持久执行日志、审批与事件保存；false 仅让新任务回到内存模式，不删除旧检查点。
# 开启时每个决策和工具调用都会增加 SQLite 写入，以支持服务重启后继续任务。
AGENT_CHECKPOINT_ENABLED=true

